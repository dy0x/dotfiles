macos-titlebar-style = hidden
font-family = "FiraCode Nerd Font"
font-size = 20
background = 000000
background-opacity = 1.00

shell-integration = zsh
macos-option-as-alt = true
quit-after-last-window-closed = true
window-padding-y = 10,0

config-file = ?auto/theme.ghostty

# Cmd+1 to Cmd+8
keybind = super+1=text:\x01\x31
keybind = super+2=text:\x01\x32
keybind = super+3=text:\x01\x33
keybind = super+4=text:\x01\x34
keybind = super+5=text:\x01\x35
keybind = super+6=text:\x01\x36
keybind = super+7=text:\x01\x37
keybind = super+8=text:\x01\x38

# Cmd+digit_1 to Cmd+digit_8
keybind = super+digit_1=text:\x01\x31
keybind = super+digit_2=text:\x01\x32
keybind = super+digit_3=text:\x01\x33
keybind = super+digit_4=text:\x01\x34
keybind = super+digit_5=text:\x01\x35
keybind = super+digit_6=text:\x01\x36
keybind = super+digit_7=text:\x01\x37
keybind = super+digit_8=text:\x01\x38

# Cmd+letter shortcuts
keybind = super+l=text:\x01\x4c
keybind = super+t=text:\x01\x63
keybind = super+w=text:\x01\x78
keybind = super+f=text:\x01\x66
keybind = super+o=text:\x01\x4f
keybind = super+p=text:\x01\x70
keybind = super+y=text:\x01\x79
keybind = super+g=text:\x01\x47
keybind = super+d=text:\x01\x44
keybind = super+m=text:\x01\x6d
